<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Ordinary Cascadia/California line kinds: no Super Mutants (leaders already locked
       separately in LimitSupermutantApparel). SM share is via dedicated kinds in groups. -->
  <Operation Class="XmlExtensions.PatchOperationAddOrReplace" MayRequire="FIP.WestTek,FIP.HHTools">
    <xpath>Defs/PawnKindDef[(starts-with(defName,'HHTools_CascadiaCivil_') or starts-with(defName,'HHTools_CascadiaRough_') or starts-with(defName,'HHTools_CascadiaRaider_') or starts-with(defName,'HHTools_CascadiaTribal_')) and not(contains(defName,'_Leader'))]</xpath>
    <value>
      <xenotypeSet>
        <xenotypeChances>
          <WestTek_Xenotype_Cascadia>0.941</WestTek_Xenotype_Cascadia>
          <WestTek_Xenotype_Ghoul>0.059</WestTek_Xenotype_Ghoul>
        </xenotypeChances>
      </xenotypeSet>
    </value>
  </Operation>
  <Operation Class="XmlExtensions.PatchOperationAddOrReplace" MayRequire="FIP.WestTek,FIP.HHTools">
    <xpath>Defs/PawnKindDef[(starts-with(defName,'HHTools_California_Settlement_') or starts-with(defName,'HHTools_California_Raider_') or starts-with(defName,'HHTools_California_Tribal_')) and not(contains(defName,'_Leader'))]</xpath>
    <value>
      <xenotypeSet>
        <xenotypeChances>
          <WestTek_Xenotype_TwoCalifornia>0.842</WestTek_Xenotype_TwoCalifornia>
          <WestTek_Xenotype_Ghoul>0.158</WestTek_Xenotype_Ghoul>
        </xenotypeChances>
      </xenotypeSet>
    </value>
  </Operation>

