<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Remove the research project -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ResearchProjectDef[defName='PlateArmor']</xpath>
  </Operation>

  <!-- Remove Plate Armor -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Apparel_PlateArmor']/recipeMaker</xpath>
    <value><recipeMaker Inherit="False" /></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Apparel_PlateArmor']/thingCategories</xpath>
    <value><thingCategories Inherit="False" /></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Apparel_PlateArmor']/tradeTags</xpath>
    <value><tradeTags Inherit="False" /></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Apparel_PlateArmor']/thingSetMakerTags</xpath>
    <value><thingSetMakerTags Inherit="False" /></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Apparel_PlateArmor']/apparel/tags</xpath>
    <value><tags Inherit="False" /></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Apparel_PlateArmor']/apparel/defaultOutfitTags</xpath>
    <value><defaultOutfitTags Inherit="False" /></value>
  </Operation>

  <!-- Remove Plate Armor from pawn kinds that require it -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/PawnKindDef[defName='Tribal_ChiefMelee']/apparelRequired/li[.='Apparel_PlateArmor']</xpath>
  </Operation>

  <!-- Vanilla Armour Expanded plate / chain pieces that still require PlateArmor -->
  <Operation Class="XmlExtensions.ApplyPatch" MayRequire="VanillaExpanded.VARME">
    <patchName>Falloutization_Equipment_Remove_Apparel</patchName>
    <arguments>
      <li>Defs/ThingDef[defName="VAE_Apparel_LightPlateArmor"]</li>
    </arguments>
  </Operation>
  <Operation Class="XmlExtensions.ApplyPatch" MayRequire="VanillaExpanded.VARME">
    <patchName>Falloutization_Equipment_Remove_Apparel</patchName>
    <arguments>
      <li>Defs/ThingDef[defName="VAE_Apparel_PlateShoulderpads"]</li>
    </arguments>
  </Operation>
  <Operation Class="XmlExtensions.ApplyPatch" MayRequire="VanillaExpanded.VARME">
    <patchName>Falloutization_Equipment_Remove_Apparel</patchName>
    <arguments>
      <li>Defs/ThingDef[defName="VAE_Apparel_Chestplate"]</li>
    </arguments>
  </Operation>
  <Operation Class="XmlExtensions.ApplyPatch" MayRequire="VanillaExpanded.VARME">
    <patchName>Falloutization_Equipment_Remove_Apparel</patchName>
    <arguments>
      <li>Defs/ThingDef[defName="VAE_Apparel_Chainmail"]</li>
    </arguments>
  </Operation>
  <Operation Class="XmlExtensions.ApplyPatch" MayRequire="VanillaExpanded.VARME">
    <patchName>Falloutization_Equipment_Remove_Apparel</patchName>
    <arguments>
      <li>Defs/ThingDef[defName="VAE_Apparel_PlateHelmet"]</li>
    </arguments>
  </Operation>
  <Operation Class="XmlExtensions.ApplyPatch" MayRequire="VanillaExpanded.VARME">
    <patchName>Falloutization_Equipment_Remove_Apparel</patchName>
    <arguments>
      <li>Defs/ThingDef[defName="VAE_Handwear_PlateGloves"]</li>
    </arguments>
  </Operation>
  <Operation Class="XmlExtensions.ApplyPatch" MayRequire="VanillaExpanded.VARME">
    <patchName>Falloutization_Equipment_Remove_Apparel</patchName>
    <arguments>
      <li>Defs/ThingDef[defName="VAE_Footwear_PlateBoots"]</li>
    </arguments>
  </Operation>
</Patch>
