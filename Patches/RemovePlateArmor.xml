<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Remove the research project -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ResearchProjectDef[defName='PlateArmor']</xpath>
  </Operation>

  <!-- Remove Plate Armor -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Apparel_PlateArmor']/recipeMaker</xpath>
    <value><recipeMaker Inherit="False" /></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Apparel_PlateArmor']/thingCategories</xpath>
    <value><thingCategories Inherit="False" /></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Apparel_PlateArmor']/tradeTags</xpath>
    <value><tradeTags Inherit="False" /></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Apparel_PlateArmor']/thingSetMakerTags</xpath>
    <value><thingSetMakerTags Inherit="False" /></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Apparel_PlateArmor']/apparel/tags</xpath>
    <value><tags Inherit="False" /></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Apparel_PlateArmor']/apparel/defaultOutfitTags</xpath>
    <value><defaultOutfitTags Inherit="False" /></value>
  </Operation>

  <!-- Remove Plate Armor from pawn kinds that require it -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/PawnKindDef[defName='Tribal_ChiefMelee' or defName='Empire_Fighter_Champion']/apparelRequired/li[.='Apparel_PlateArmor']</xpath>
  </Operation>

  <!-- Whitespring old guard (Champion): plate+shield were the only forced outfit, and
       Whitespring+FCP Enclave also clears apparelRequired. Force Whitespring light armor
       (Absolver) — full-body, unlike Janissary heavy which is chest-only / not clothing. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>FIP - Whitespring</li>
    </mods>
    <match Class="PatchOperationFindMod">
      <mods>
        <li>Vanilla Factions Expanded - Empire</li>
      </mods>
      <match Class="PatchOperationConditional">
        <xpath>Defs/PawnKindDef[defName='Empire_Fighter_Champion']/apparelRequired</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/PawnKindDef[defName='Empire_Fighter_Champion']/apparelRequired</xpath>
          <value>
            <apparelRequired Inherit="False">
              <li>VFEE_Apparel_AbsolverHelmet</li>
              <li>VFEE_Apparel_ArmorAbsolver</li>
            </apparelRequired>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/PawnKindDef[defName='Empire_Fighter_Champion']</xpath>
          <value>
            <apparelRequired Inherit="False">
              <li>VFEE_Apparel_AbsolverHelmet</li>
              <li>VFEE_Apparel_ArmorAbsolver</li>
            </apparelRequired>
          </value>
        </nomatch>
      </match>
    </match>
  </Operation>

  <!-- VFE Medieval 2 still requires PlateArmor; FIP handles the apparel, so only drop the prereq. -->
  <Operation Class="PatchOperationRemove" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/ThingDef[defName='VFEM2_Apparel_PlateArmorHeavy' or defName='VFEM2_Apparel_HeavyLeatherArmor' or defName='VFEM2_Apparel_PlateHelmetHeavy' or defName='VFEM2_Apparel_HeavyLeatherHelmet' or defName='VFEM2_Shield_Heater']/recipeMaker/researchPrerequisite</xpath>
  </Operation>

  <!-- VPE prestige plate still prereqs deleted PlateArmor research; remove it entirely. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Psycasts Expanded</li>
    </mods>
    <match Class="XmlExtensions.ApplyPatch">
      <patchName>Falloutization_Equipment_Remove_Apparel</patchName>
      <arguments>
        <li>Defs/ThingDef[defName="VPE_Apparel_PlateArmorPrestige"]</li>
      </arguments>
    </match>
  </Operation>
</Patch>
