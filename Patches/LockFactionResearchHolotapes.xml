<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Lock unlocked FCP_Faction_Research projects behind holotape techprints.
       Already-holotape projects (BoS Advanced Weapons, Enclave PA / MkII / Plasma) are skipped.
       Permit-tree factions: commonality 0 + dummy heldBy so traders and quest rewards never stock them.
       Raiders / Marked Men: stocked by the Wastelander techprint merchant. -->

  <!--__________ Shared holotape fields __________-->

  <!-- Permit factions: no trader / quest generation -->
  <!-- Merchant factions: wastelander techprint traders -->

  <!--__________ Brotherhood of Steel __________-->

  <Operation Class="PatchOperationSequence" MayRequire="Rick.FCP.BOS">
    <operations>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="FCP_Research_BoS_Initiate_Equipment"]/label</xpath>
        <value><label>Holotape File: Initiate and Squire Equipment</label></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="FCP_Research_BoS_Initiate_Equipment"]/description</xpath>
        <value><description>Military holotape containing the schematics and manufacturing processes for Initiate and Squire Equipment.</description></value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ResearchProjectDef[defName="FCP_Research_BoS_Initiate_Equipment"]</xpath>
        <value>
          <techprintCount>1</techprintCount>
          <techprintCommonality>0</techprintCommonality>
          <heldByFactionCategoryTags>
            <li>FE_NoTraderTechprints</li>
          </heldByFactionCategoryTags>
          <modExtensions>
            <li Class="FCP.Core.TechprintExtension">
              <baseLabel>FCP_Techprint_Label</baseLabel>
              <baseDescription>FCP_Techprint_Desc</baseDescription>
              <texPath>Things/Items/Techprints/FCP_Techprint_Holotape_Mil</texPath>
              <requiredBenches>
                <li>FCP_Production_Old_Table_Terminal</li>
                <li>FCP_Production_Clean_Table_Terminal</li>
              </requiredBenches>
            </li>
          </modExtensions>
        </value>
      </li>
    </operations>
  </Operation>

