  </Operation>
  <Operation Class="XmlExtensions.PatchOperationEditString">
    <xpath>Defs/HediffDef[defName='ArchotechEye']/description</xpath>
    <replaceWith>An installed pre-war cybernetic eye. It perceives every type of electromagnetic radiation, including radio waves, infrared, light, x-rays, and gamma rays. Its visual acuity is precise enough to read handwriting from twenty meters away. It can emit various wavelengths of radiation like a flashlight, and has an internal subpersona AI which helps highlight useful visual information. Its internal workings are a mystery to human minds.</replaceWith>
  </Operation>
