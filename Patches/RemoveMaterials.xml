<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- Hyperweave -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingSetMakerDef[defName='MapGen_AncientComplexRoomLoot_Default']//li[.='Hyperweave']</xpath>
    </Operation>
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingSetMakerDef[defName='MapGen_AncientComplexRoomLoot_Better']//li[.='Hyperweave']</xpath>
    </Operation>
    <Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Odyssey">
        <xpath>Defs/ThingSetMakerDef[defName='MapGen_ScarlandsHermeticCrate']//li[.='Hyperweave']</xpath>
    </Operation>
    <Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Odyssey">
        <xpath>Defs/ThingSetMakerDef[defName='MapGen_HighValueCrate']//li[.='Hyperweave']</xpath>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Hyperweave"]</xpath>
        <value><preventSpawningInResourcePod>true</preventSpawningInResourcePod></value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Hyperweave"]/stuffProps</xpath>
        <value><stuffProps Inherit="False" /></value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Hyperweave"]</xpath>
        <value>
            <thingCategories Inherit="False" />
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Hyperweave"]/thingSetMakerTags</xpath>
        <value>
            <thingSetMakerTags Inherit="False" />
        </value>
    </Operation>

    <!-- Bioferrite -->
    <Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Anomaly">
        <xpath>Defs/ThingSetMakerDef[defName='MapGen_AncientComplexRoomLoot_Better']/root/options/li[thingSetMaker/fixedParams/filter/thingDefs/li='Bioferrite']</xpath>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Bioferrite"]</xpath>
        <value><preventSpawningInResourcePod>true</preventSpawningInResourcePod></value>
    </Operation>

    <!-- Gravlite Panels -->
    <Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Odyssey">
        <xpath>Defs/ThingSetMakerDef[defName='MapGen_ScarlandsHermeticCrate']/root/options/li[thingSetMaker/fixedParams/filter/thingDefs/li='GravlitePanel']</xpath>
    </Operation>
    <Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Odyssey">
        <xpath>Defs/ThingSetMakerDef[defName='MapGen_HighValueCrate']/root/options/li[thingSetMaker/fixedParams/filter/thingDefs/li='GravlitePanel']</xpath>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="GravlitePanel"]</xpath>
        <value><preventSpawningInResourcePod>true</preventSpawningInResourcePod></value>
    </Operation>

    <!-- Eltex (Vanilla Psycasts Expanded) -->
    <Operation Class="PatchOperationRemove" MayRequire="VanillaExpanded.VPsycastsE">
        <xpath>Defs/ThingDef[defName="VPE_Eltex"]/thingSetMakerTags</xpath>
    </Operation>
    <Operation Class="PatchOperationAdd" MayRequire="VanillaExpanded.VPsycastsE">
        <xpath>Defs/ThingDef[defName="VPE_Eltex"]</xpath>
        <value><preventSpawningInResourcePod>true</preventSpawningInResourcePod></value>
    </Operation>
    <Operation Class="PatchOperationRemove" MayRequire="VanillaExpanded.VPsycastsE">
        <xpath>Defs/QuestScriptDef[defName="VPE_EltexMeteor"]</xpath>
    </Operation>
    <Operation Class="PatchOperationRemove" MayRequire="VanillaExpanded.VPsycastsE">
        <xpath>Defs/IncidentDef[defName="VPE_EltexMeteorite"]</xpath>
    </Operation>

    <!-- Aramid cloth (Ancient urban ruins). MayRequire on an Operation is ignored in 1.6. -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Ancient urban ruins</li>
            <li>XMB.AncientUrbanrUins.MO</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <!-- Dedicated flak-material roll is only aramid; drop the whole option. -->
                <li Class="PatchOperationRemove">
                    <xpath>Defs/ThingSetMakerDef[defName='AM_FlakMaterial']/root/options/li[thingSetMaker/fixedParams/filter/thingDefs/li='AM_AramidCloth']</xpath>
                </li>
                <li Class="PatchOperationRemove">
                    <xpath>Defs//thingDefs/li[.='AM_AramidCloth']</xpath>
                </li>
                <li Class="PatchOperationRemove">
                    <xpath>Defs//thingDef[.='AM_AramidCloth']</xpath>
                </li>
                <li Class="PatchOperationRemove">
                    <xpath>Defs//def[.='AM_AramidCloth']</xpath>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="AM_AramidCloth"]</xpath>
                    <value><preventSpawningInResourcePod>true</preventSpawningInResourcePod></value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="AM_AramidCloth"]/stuffProps</xpath>
                    <value><stuffProps Inherit="False" /></value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="AM_AramidCloth"]</xpath>
                    <value>
                        <thingCategories Inherit="False" />
                    </value>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>
