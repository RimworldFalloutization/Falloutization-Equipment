  <!-- Strip trade tags so gravship upgrades are not sold or bought -->
  <Operation Class="PatchOperationReplace" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/ThingDef[defName='FuelOptimizer']/tradeTags</xpath>
    <value><tradeTags Inherit="False" /></value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/ThingDef[defName='PilotSubpersonaCore']/tradeTags</xpath>
    <value><tradeTags Inherit="False" /></value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/ThingDef[defName='GravshipShieldGenerator']/tradeTags</xpath>
    <value><tradeTags Inherit="False" /></value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/ThingDef[defName='GravlitePanel']/tradeTags</xpath>
    <value><tradeTags Inherit="False" /></value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/ThingDef[defName='GravlitePanel']/recipeMaker</xpath>
    <value><recipeMaker Inherit="False" /></value>
  </Operation>

  <!-- Remove research prerequisites before deleting gravtech projects -->
  <Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/ThingDef[defName='GravshipHull']/researchPrerequisites</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Odyssey">
