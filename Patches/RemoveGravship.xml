  <!-- Independent random quest that scavenges gravtech from a crashed gravship -->
  <Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/QuestScriptDef[defName='GravshipWreckage']</xpath>
  </Operation>

  <!-- Quests that require BasicGravtech and reward gravship upgrades -->
  <Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/QuestScriptDef[defName='OrbitalFugitive']</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/QuestScriptDef[defName='SurveySite']</xpath>
  </Operation>

  <!-- Starting scenario that begins with a gravship and a Grav Engine -->
  <Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/ScenarioDef[defName='TheGravship']</xpath>
  </Operation>

