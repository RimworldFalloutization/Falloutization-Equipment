  <Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/ThingDef[defName='PilotAssistant']/recipeMaker/researchPrerequisite</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/ThingDef[defName='Schematic']//exclude/BasicGravtech</xpath>
