<Patch>
  <!-- ========== Core ship-to-the-stars (not Odyssey gravships) ========== -->

  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ResearchProjectDef[@ParentName='ShipResearchProjectBase']</xpath>
  </Operation>

  <Operation Class="PatchOperationRemove">
    <xpath>Defs/DesignationCategoryDef[defName='Ship']/researchPrerequisites</xpath>
  </Operation>

  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName='Ship_Beam']/researchPrerequisites</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName='Ship_CryptosleepCasket']/researchPrerequisites</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName='Ship_ComputerCore']/researchPrerequisites</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName='Ship_Reactor']/researchPrerequisites</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName='Ship_Engine']/researchPrerequisites</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName='Ship_SensorCluster']/researchPrerequisites</xpath>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[designationCategory='Ship']/designationCategory</xpath>
    <value>
      <designationCategory IsNull="True"/>
    </value>
  </Operation>

  <Operation Class="PatchOperationRemove">
    <xpath>Defs/DesignationCategoryDef[defName='Ship']</xpath>
  </Operation>

  <!-- ========== Odyssey gravships ========== -->

  <!-- Stop Mechanoid Signal: BaseStoryteller (and inheriting storytellers) fire
       GiveQuest_MechanoidSignal after 6 days. This is the normal way to get a Grav Engine. -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/StorytellerDef[@Name='BaseStoryteller']/comps/li[@Class='StorytellerCompProperties_ImportantQuest']</xpath>
  </Operation>

  <Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/IncidentDef[defName='GiveQuest_MechanoidSignal']</xpath>
  </Operation>

  <Operation Class="PatchOperationRemove" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/QuestScriptDef[defName='MechanoidSignal']</xpath>
  </Operation>

