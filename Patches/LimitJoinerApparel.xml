<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    Beggars, pilgrims, and royalty refugees define their own apparelTags and belong
    to hidden charity factions with no wardrobe of their own. Point those at the
    unfactioned wasteland wardrobe (FCP_Wastelander_Apparel).

    Villager, Villager_Child, SpaceRefugee, and SpaceRefugee_Clothed inherit
    apparelTags, so a replace on the concrete def does not change the resolved
    kind. Those kinds, and factioned guests (including Empire_Common_Lodger and
    WellEquippedTraveler), are dressed when the pawn is generated. Settlement
    villagers are not retagged here.
  -->
  <Operation Class="PatchOperationReplace" MayRequire="Rick.FCP.Wastelanders">
    <xpath>Defs/PawnKindDef[
      defName='Refugee' or
      defName='Beggar' or
      defName='PovertyPilgrim'
    ]/apparelTags</xpath>
    <value>
      <apparelTags Inherit="False">
        <li>FCP_Wastelander_Apparel</li>
      </apparelTags>
    </value>
  </Operation>

  <!-- Cheapest wasteland outfits are about 100-130. These budgets bottom out below that, so a low roll finds nothing wearable and the pawn arrives naked. -->
  <Operation Class="PatchOperationReplace" MayRequire="Rick.FCP.Wastelanders">
    <xpath>Defs/PawnKindDef[defName='Beggar']/apparelMoney</xpath>
    <value>
      <apparelMoney>120~190</apparelMoney>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="Rick.FCP.Wastelanders">
    <xpath>Defs/PawnKindDef[defName='PovertyPilgrim']/apparelMoney</xpath>
    <value>
      <apparelMoney>120~250</apparelMoney>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="Rick.FCP.Wastelanders">
    <xpath>Defs/PawnKindDef[defName='Refugee']/apparelMoney</xpath>
    <value>
      <apparelMoney>120~280</apparelMoney>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="Rick.FCP.Wastelanders">
    <xpath>Defs/PawnKindDef[defName='SpaceRefugee']/apparelMoney</xpath>
    <value>
      <apparelMoney>120~1000</apparelMoney>
    </value>
  </Operation>
</Patch>
